BOT_TOKEN=
# Supabase project settings -> API
SUPABASE_URL=https://your-project.supabase.co
# service_role key: the bot writes data and uploads photos, keep it secret
SUPABASE_SERVICE_KEY=
# Public website URL, https only (optional). When set, the bot adds a Website menu button,
# a /site command, and "View on the website" buttons that open each listing on the site.
SITE_URL=
# Telegram user IDs of moderators who approve teams that aren't on the USTEM Connect
# list, comma separated. Get yours from @userinfobot. Users with role 'admin' in the
# database are moderators too.
ADMIN_IDS=
